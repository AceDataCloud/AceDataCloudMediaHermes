{
  "service": "gpt-image",
  "title": "Ace Data Cloud GPT Image",
  "kind": "image",
  "description": "GPT Image 2 text-to-image generation through your Ace Data Cloud account.",
  "tool_prefix": "acedatacloud_gpt_image",
  "generate_path": "/openai/images/generations",
  "task_path": "/openai/tasks",
  "defaults": {
    "model": "gpt-image-2",
    "size": "1024x1024",
    "quality": "auto",
    "n": 1,
    "response_format": "url"
  },
  "generate_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "maxLength": 4000
      },
      "model": {
        "type": "string",
        "enum": [
          "gpt-image-2"
        ],
        "maxLength": 4000
      },
      "size": {
        "type": "string",
        "enum": [
          "1024x1024",
          "1024x1536",
          "1536x1024"
        ],
        "maxLength": 4000
      },
      "quality": {
        "type": "string",
        "enum": [
          "auto",
          "low",
          "medium",
          "high"
        ],
        "maxLength": 4000
      },
      "n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      }
    }
  },
  "task_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "task_id"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "maxLength": 128,
        "pattern": "[A-Za-z0-9_-]+"
      },
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60
      }
    }
  },
  "generate_name": "acedatacloud_gpt_image_generate",
  "tools": [
    "acedatacloud_gpt_image_generate",
    "acedatacloud_gpt_image_task"
  ],
  "toolset": "acedatacloud-gpt-image"
}
