{
  "service": "happyhorse",
  "title": "Ace Data Cloud Happy Horse",
  "kind": "video",
  "description": "Happy Horse text-to-video generation through your Ace Data Cloud account.",
  "tool_prefix": "acedata_happyhorse",
  "generate_path": "/happyhorse/videos",
  "task_path": "/happyhorse/tasks",
  "defaults": {
    "action": "generate",
    "resolution": "720P",
    "duration": 3,
    "ratio": "16:9",
    "model": "happyhorse-1.0-t2v"
  },
  "generate_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "maxLength": 4000
      },
      "ratio": {
        "enum": [
          "16:9",
          "9:16",
          "1:1",
          "4:3",
          "3:4"
        ],
        "type": "string",
        "maxLength": 4000
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 15
      },
      "resolution": {
        "enum": [
          "720P",
          "1080P"
        ],
        "type": "string",
        "maxLength": 4000
      },
      "model": {
        "type": "string",
        "enum": [
          "happyhorse-1.0-t2v",
          "happyhorse-1.1-t2v"
        ],
        "maxLength": 4000
      }
    }
  },
  "task_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "task_id"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "maxLength": 128,
        "pattern": "[A-Za-z0-9_-]+"
      },
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60
      }
    }
  },
  "generate_name": "acedata_happyhorse_generate",
  "tools": [
    "acedata_happyhorse_generate",
    "acedata_happyhorse_task"
  ],
  "toolset": "acedata-happyhorse"
}
