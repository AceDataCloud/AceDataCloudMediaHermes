{
  "service": "nano-banana",
  "title": "Ace Data Cloud Nano Banana",
  "kind": "images",
  "description": "Image generation and HTTPS reference-image editing through your Ace Data Cloud account.",
  "tool_prefix": "acedata_nano_banana",
  "generate_path": "/nano-banana/images",
  "task_path": "/nano-banana/tasks",
  "defaults": {
    "model": "nano-banana-2-lite",
    "aspect_ratio": "1:1",
    "resolution": "1K",
    "count": 1,
    "action": "generate"
  },
  "generate_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "maxLength": 4000
      },
      "model": {
        "type": "string",
        "enum": [
          "nano-banana",
          "nano-banana-2-lite",
          "nano-banana-2",
          "nano-banana-pro",
          "nano-banana:official",
          "nano-banana-2-lite:official",
          "nano-banana-2:official",
          "nano-banana-pro:official"
        ],
        "maxLength": 4000
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "1:1",
          "3:2",
          "2:3",
          "16:9",
          "9:16",
          "4:3",
          "3:4"
        ],
        "maxLength": 4000
      },
      "resolution": {
        "type": "string",
        "enum": [
          "1K",
          "2K",
          "4K"
        ],
        "maxLength": 4000
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "image_urls": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "minItems": 1,
        "maxItems": 4
      }
    }
  },
  "task_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "task_id"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "maxLength": 128,
        "pattern": "[A-Za-z0-9_-]+"
      },
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60
      }
    }
  },
  "generate_name": "acedata_nano_banana_generate",
  "tools": [
    "acedata_nano_banana_generate",
    "acedata_nano_banana_task"
  ],
  "toolset": "acedata-nano-banana"
}
