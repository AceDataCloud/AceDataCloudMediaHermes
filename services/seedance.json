{
  "service": "seedance",
  "title": "Ace Data Cloud Seedance",
  "kind": "video",
  "description": "Seedance 2.0 Mini text-to-video and first-frame animation through your Ace Data Cloud account.",
  "tool_prefix": "acedatacloud_seedance",
  "generate_path": "/seedance/videos",
  "task_path": "/seedance/tasks",
  "defaults": {
    "model": "doubao-seedance-2-0-mini-260615",
    "resolution": "480p",
    "ratio": "16:9",
    "generate_audio": false,
    "duration": 4
  },
  "generate_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "prompt"
    ],
    "properties": {
      "resolution": {
        "type": "string",
        "enum": [
          "480p",
          "720p",
          "1080p",
          "4k"
        ],
        "maxLength": 4000
      },
      "ratio": {
        "type": "string",
        "enum": [
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16",
          "21:9",
          "adaptive"
        ],
        "maxLength": 4000
      },
      "duration": {
        "type": "integer",
        "minimum": 4,
        "maximum": 15
      },
      "generate_audio": {
        "type": "boolean"
      },
      "prompt": {
        "type": "string",
        "maxLength": 4000
      },
      "model": {
        "type": "string",
        "enum": [
          "doubao-seedance-2-0-mini-260615"
        ],
        "maxLength": 4000
      },
      "first_frame_url": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      }
    }
  },
  "task_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "task_id"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "maxLength": 128,
        "pattern": "[A-Za-z0-9_-]+"
      },
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 60
      }
    }
  },
  "generate_name": "acedatacloud_seedance_generate",
  "tools": [
    "acedatacloud_seedance_generate",
    "acedatacloud_seedance_task"
  ],
  "toolset": "acedatacloud-seedance"
}
